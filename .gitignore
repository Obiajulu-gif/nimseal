# Dependencies
**/node_modules/
**/.pnp
**/.pnp.js

# Next.js
**/.next/
**/out/
**/next-env.d.ts

# TypeScript incremental build state
*.tsbuildinfo

# Hardhat / Solidity
**/artifacts/
**/artifacts-hardhat/
**/cache/
**/typechain-types/
**/coverage/
coverage.json

# Secrets — never commit
**/.env
**/.env.local
**/.env.*.local
!**/.env.example
*.pem
*.key

# Local-only deployment output. <network>-<chainId>.json IS committed: public metadata only.
contracts/deployments/local*.json
contracts/deployments/*.local.json

# Installed AI skills. The Nimiq mini-apps skill is vendored by `npx skills add` (regenerable);
# skills-lock.json pins it and .claude/launch.json is kept. The symlinked copy is not portable.
.agents/
.claude/skills/

# Playwright
**/test-results/
**/playwright-report/
**/.playwright/

# Editors and OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

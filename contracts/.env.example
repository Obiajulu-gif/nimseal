# EVM RPC endpoints. Polygon is the production deployment target; Sepolia is for rehearsal.
# Public endpoints work; set your own for reliability.
POLYGON_RPC_URL=https://polygon-rpc.com
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# A funded key you control. Read only from the environment, never committed. Fund it with POL
# (Polygon) or Sepolia ETH for gas.
DEPLOYER_PRIVATE_KEY=
OWNER_ADDRESS=

REFUND_GRACE_PERIOD_SECONDS=604800

POLYGON_EXPLORER_BASE_URL=https://polygonscan.com
SEPOLIA_EXPLORER_BASE_URL=https://sepolia.etherscan.io

# Polygon defaults to canonical USDT (0xc2132D05D31c914a87C6611C10748AEb04B58e8F, 6 decimals).
# Sepolia has no canonical USDT, so deploy a 6-decimal MockERC20 (npm run deploy-token:sepolia)
# and point this at it before deploying the escrow.
SETTLEMENT_TOKEN_ADDRESS=

# Only used by scripts/configure-attestor.ts. Must be the address the attestor service reports from
# its /info endpoint — never the deployer or the owner.
ATTESTOR_SIGNING_ADDRESS=
ATTESTOR_URL=http://127.0.0.1:3000/api/attestor

{
  "name": "botseal-contracts",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "BotSeal confidential invoice + USDT escrow contracts for Nimiq Pay (Polygon / Sepolia)",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "clean": "hardhat clean",
    "export-abi": "hardhat run scripts/export-abi.ts",
    "deploy:polygon": "hardhat run scripts/deploy.ts --network polygon",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "configure-attestor:polygon": "hardhat run scripts/configure-attestor.ts --network polygon",
    "configure-attestor:sepolia": "hardhat run scripts/configure-attestor.ts --network sepolia",
    "smoke:polygon": "hardhat run scripts/smoke.ts --network polygon",
    "smoke:sepolia": "hardhat run scripts/smoke.ts --network sepolia",
    "seed-demo:polygon": "hardhat run scripts/seed-demo-invoice.ts --network polygon",
    "seed-demo:sepolia": "hardhat run scripts/seed-demo-invoice.ts --network sepolia",
    "rehearse": "hardhat run scripts/rehearse-local.ts",
    "preflight:sepolia": "hardhat run scripts/preflight.ts --network sepolia",
    "preflight:polygon": "hardhat run scripts/preflight.ts --network polygon",
    "deploy-token:sepolia": "hardhat run scripts/deploy-token.ts --network sepolia",
    "smoke-live:sepolia": "hardhat run scripts/smoke-live.ts --network sepolia"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.8",
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.12",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "chai": "^4.5.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "hardhat": "^2.22.18",
    "solidity-coverage": "^0.8.14",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0"
  }
}

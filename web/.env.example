# Copy to .env.local and fill in after deploying. Never commit .env.local.

# --- Network ---------------------------------------------------------------
# The EVM chain nimSeal settles on, through the Nimiq Pay Ethereum provider.
#   137      = Polygon  (production, real USDT)
#   11155111 = Sepolia  (development/testing, mock ERC-20)
# Any other id is rejected at startup.
NEXT_PUBLIC_EVM_CHAIN_ID=137

# Optional. Leave blank to use the chain's public RPC / explorer defaults
# (Polygon: polygon-rpc.com / polygonscan.com; Sepolia: rpc.sepolia.org / sepolia.etherscan.io).
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=

# --- Deployed contracts ----------------------------------------------------
# From contracts/deployments/<network>-<chainId>.json after deploying the escrow.
NEXT_PUBLIC_ESCROW_ADDRESS=

# USDT on Polygon (canonical, 6 decimals). On Sepolia, the 6-decimal MockERC20 you deployed.
NEXT_PUBLIC_SETTLEMENT_TOKEN_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F

# --- Modes -----------------------------------------------------------------
# Exposes the unverified public-invoice path in the UI. Keep false unless the
# attestor is unavailable and a demo needs to continue.
NEXT_PUBLIC_ENABLE_PUBLIC_MODE=false

# --- Attestor (SERVER-ONLY — never prefix these NEXT_PUBLIC_) ---------------
# The signing key whose address the escrow verifies against. Whoever holds it
# can mint settlement facts the escrow will accept, and can read any invoice
# submitted to this service. Generate it in your own wallet tooling, set it in
# the host's secret store, and rotate it after any demo.
#
# This is the whole trust assumption of the confidential path. It is a server
# key, not a TEE: there is no hardware attestation. See docs/SECURITY.md.
ATTESTOR_PRIVATE_KEY=

# The escrow the attestor will mint results for. Defaults to
# NEXT_PUBLIC_ESCROW_ADDRESS when unset.
ATTESTOR_ESCROW_ADDRESS=
